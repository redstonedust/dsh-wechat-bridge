{
  "name": "dsh-wechat-bridge",
  "version": "0.1.0",
  "description": "微信接入桥接插件：Webhook/Official Account 网关 + wechat_* 工具 + 每会话自动回复 agent，并附带可注入人格 md 的 wechat-agent 模式",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "persona/*.md",
    "scripts/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build:preset": "node scripts/build-preset.mjs",
    "selftest": "node scripts/selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/wechat-agent.patch.yml"
      ]
    }
  }
}
