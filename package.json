{
  "name": "dsh-wechat-bridge",
  "version": "0.3.0",
  "description": "微信接入桥接插件：Webhook / 公众号 / 企微群机器人 / 个人微信 hook（主动轮询）+ wechat_* 工具 + 每会话自动回复 agent + 一键管理面板",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "presets/*.patch.yml",
    "persona/*.md",
    "gateway/*.mjs",
    "gateway/README.md",
    "scripts/*.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build:preset": "node scripts/build-preset.mjs",
    "selftest": "node scripts/selftest.mjs",
    "test:hook": "node scripts/test-hook-gateway.mjs && node scripts/test-hook-integration.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/wechat-agent.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
